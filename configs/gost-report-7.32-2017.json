  "page_numbers": {
    "enabled": true,
    "position": "footer",
    "align": "center",
    "omit_first_page": true,
    "format": "arabic",
    "size_pt": 12
  },
  "structural_heading": {
    "align": "center",
    "first_line_indent_cm": 0,
    "space_before_pt": 0,
    "space_after_pt": 12,
    "line_spacing": 1.5,
    "bold": false,
    "keep_with_next": true,
    "page_break_before": true
  },
  "headings": {
    "1": {
      "align": "left",
      "first_line_indent_cm": 1.25,
      "space_before_pt": 12,
      "space_after_pt": 12,
      "line_spacing": 1.5,
      "bold": true,
      "keep_with_next": true,
      "page_break_before": true
    },
    "2": {
      "align": "left",
      "first_line_indent_cm": 1.25,
      "space_before_pt": 10,
      "space_after_pt": 8,
      "line_spacing": 1.5,
      "bold": true,
      "keep_with_next": true
    },
    "3": {
      "align": "left",
      "first_line_indent_cm": 1.25,
      "space_before_pt": 8,
      "space_after_pt": 6,
      "line_spacing": 1.5,
      "bold": false,
      "keep_with_next": true
    }
  },
  "figure": {
    "align": "center",
    "first_line_indent_cm": 0,
    "max_width_cm": 15,
    "keep_together": true
  },
  "code": {
    "font": "DejaVu Sans",
    "size_pt": 11,
    "line_spacing": 1,
    "left_indent_cm": 0,
    "space_before_pt": 6,
    "space_after_pt": 6,
    "keep_together": false
  },
  "cover": {
    "page_break_after": false,
    "parts": [
      {
        "text": "{organization}",
        "align": "center",
        "size_pt": 14
      },
      {
        "text": "{organization_unit}",
        "align": "center",
        "size_pt": 14
      },
      {
        "text": "",
        "align": "center",
        "size_pt": 12,
        "space_before_pt": 36
      },
      {
        "text": "ОТЧЕТ",
        "align": "center",
        "size_pt": 16,
        "bold": true
      },
      {
        "text": "О НАУЧНО-ИССЛЕДОВАТЕЛЬСКОЙ РАБОТЕ",
        "align": "center",
        "size_pt": 14
      },
      {
        "text": "{topic}",
        "align": "center",
        "size_pt": 14,
        "space_before_pt": 18
      },
      {
        "text": "",
        "align": "left",
        "size_pt": 12,
        "space_before_pt": 48
      },
      {
        "text": "Руководитель: {supervisor_name}",
