        "size_pt": 14
      },
      {
        "text": "Исполнитель: {author_name}",
        "align": "right",
        "size_pt": 14
      },
      {
        "text": "",
        "align": "center",
        "size_pt": 12,
        "space_before_pt": 64
      },
      {
        "text": "{city} – {year}",
        "align": "center",
        "size_pt": 14
      }
