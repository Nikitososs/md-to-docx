{
  "extends": "fit-academic.json",
  "name": "Research report — GOST 7.32-2017",
  "standard": {
    "id": "ГОСТ 7.32-2017",
    "scope": "Structure and presentation of a research report; check that this standard applies to the assignment."
  },
  "page": {
    "width_cm": 21,
    "height_cm": 29.7,
    "top_cm": 2,
    "bottom_cm": 2,
    "left_cm": 3,
    "right_cm": 1.5,
    "footer_distance_cm": 1.25
